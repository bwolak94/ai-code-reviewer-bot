{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "moduleResolution": "NodeNext",
    "module": "NodeNext",
    "target": "ES2022",
    "strict": true,
    "rootDir": ".",
    "paths": {
      "@repo/arch-graph": ["../packages/arch-graph/dist/index.d.ts"],
      "@repo/config": ["../packages/config/dist/index.d.ts"]
    }
  },
  "include": ["*.ts"],
  // fixtures/ is intentionally excluded: each fixture has its own tsconfig.json
  // and is parsed by ts-morph at eval time, not by the eval package's compiler.
  "exclude": ["node_modules", "fixtures"]
}
