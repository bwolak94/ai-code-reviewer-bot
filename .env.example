# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://aireview:aireview_dev@localhost:5432/aireview
DATABASE_REPLICA_URL=

# ─── Redis ────────────────────────────────────────────────────────────────────
# Queue Redis (BullMQ) — noeviction policy, port 6379
REDIS_QUEUE_URL=redis://:aireview_dev@localhost:6379
REDIS_QUEUE_PASSWORD=aireview_dev

# Cache Redis (token cache, base-graph cache) — allkeys-lru, port 6380
REDIS_CACHE_URL=redis://:aireview_dev@localhost:6380
REDIS_CACHE_PASSWORD=aireview_dev

# ─── GitHub App ───────────────────────────────────────────────────────────────
GITHUB_APP_ID=
# PEM private key — paste the full PEM with literal \n, or base64-encode it
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# ─── LLM ──────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
# Set to "ollama" for local development without Anthropic
LLM_BACKEND=anthropic
OLLAMA_BASE_URL=http://localhost:11434

# ─── Application ──────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── Security ─────────────────────────────────────────────────────────────────
# 32-byte AES-256-GCM key for installation token encryption at rest (SEC-003).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must be exactly 64 lowercase hex characters.
TOKEN_ENCRYPTION_KEY=

# ─── Worker ───────────────────────────────────────────────────────────────────
WORKER_CONCURRENCY=4
WORKER_MAX_WORKSPACE_MB=512

# ─── PostgreSQL container (docker-compose) ───────────────────────────────────
POSTGRES_PASSWORD=aireview_dev
